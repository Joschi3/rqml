import QtQuick
import QtQuick.Controls
import QtQuick.Layouts
import QtQuick.Controls.Material
import Ros2
import RQml.Elements
import RQml.Fonts

/**
 * Displays TF transform information between a source and target frame.
 * Used in both the Graph View panel and the List View persistent area.
 */
Rectangle {
    id: root

    property string sourceFrame: ""
    property string targetFrame: ""
    property var buffer: null
    property bool expanded: true

    //! Signal emitted when the user requests swapping source and target
    signal swapRequested()

    //! @internal Exposes the TfTransform for test access only. Do not use in production.
    function _testTfTransform() { return d.tfTransform; }

    // Height grows and shrinks with the animated content wrapper.
    implicitHeight: headerButton.implicitHeight + contentWrapper.height
    color: palette.window
    border.color: palette.mid
    border.width: 1
    radius: 4

    QtObject {
        id: d

        readonly property bool hasFrames: root.sourceFrame !== "" && root.targetFrame !== ""

        property TfTransform tfTransform: TfTransform {
            buffer: root.buffer
            sourceFrame: root.sourceFrame
            targetFrame: root.targetFrame
            enabled: d.hasFrames && root.expanded && context.enabled
        }

        function formatNumber(x) { return d.hasFrames && d.tfTransform.valid ? x.toFixed(3) : "-" }

        function buildPayload() {
            return {
                source_frame: root.sourceFrame,
                target_frame: root.targetFrame,
                translation: {
                    x: d.tfTransform.translation.x,
                    y: d.tfTransform.translation.y,
                    z: d.tfTransform.translation.z
                },
                rotation: {
                    x: d.tfTransform.rotation.x,
                    y: d.tfTransform.rotation.y,
                    z: d.tfTransform.rotation.z,
                    w: d.tfTransform.rotation.w
                }
            };
        }

        function payloadToYaml(p) {
            return "source_frame: " + p.source_frame + "\n" +
                   "target_frame: " + p.target_frame + "\n" +
                   "translation:\n" +
                   "  x: " + p.translation.x + "\n" +
                   "  y: " + p.translation.y + "\n" +
                   "  z: " + p.translation.z + "\n" +
                   "rotation:\n" +
                   "  x: " + p.rotation.x + "\n" +
                   "  y: " + p.rotation.y + "\n" +
                   "  z: " + p.rotation.z + "\n" +
                   "  w: " + p.rotation.w + "\n";
        }
    }

    // -------------------------------------------------------------------------
    // Header / Toggle Button
    // -------------------------------------------------------------------------

    IconTextButton {
        id: headerButton
        objectName: "tfTransformDisplayHeader"
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        iconText: root.expanded ? IconFont.iconChevronDown : IconFont.iconChevronRight
        text: "Transform"
        flat: true
        topInset: 0; bottomInset: 0; leftInset: 0; rightInset: 0

        onClicked: root.expanded = !root.expanded
    }

    // -------------------------------------------------------------------------
    // Animated content area
    // -------------------------------------------------------------------------

    Item {
        id: contentWrapper
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: headerButton.bottom
        clip: true
        height: root.expanded ? contentCol.implicitHeight : 0

        Behavior on height {
            NumberAnimation { duration: 200; easing.type: Easing.InOutQuad }
        }

        ColumnLayout {
            id: contentCol
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: parent.top
            anchors.margins: 4
            spacing: 8

            Rectangle {
                Layout.fillWidth: true
                height: 1
                color: palette.mid
            }

            // Source / Target (shown only when at least one frame is set)
            RowLayout {
                Layout.fillWidth: true
                Layout.leftMargin: 8
                Layout.rightMargin: 8
                spacing: 8

                GridLayout {
                    Layout.fillWidth: true
                    columns: root.width > 480 ? 4 : 2
                    columnSpacing: 8
                    rowSpacing: 2

                    Label { text: "Source:"; font.bold: true }
                    TruncatedLabel {
                        Layout.fillWidth: true
                        Layout.preferredWidth: 1
                        text: root.sourceFrame !== "" ? root.sourceFrame : "(Select frame)"
                        font.italic: root.sourceFrame === ""
                        opacity: root.sourceFrame === "" ? 0.5 : 1.0
                    }

                    Label { text: "Target:"; font.bold: true }
                    TruncatedLabel {
                        Layout.fillWidth: true
                        Layout.preferredWidth: 1
                        text: root.targetFrame !== "" ? root.targetFrame : "(Select frame)"
                        font.italic: root.targetFrame === ""
                        opacity: root.targetFrame === "" ? 0.5 : 1.0
                    }

                }

                IconButton {
                    objectName: "tfSwapButton"
                    text: IconFont.iconRightLeft
                    tooltipText: "Swap source and target"
                    enabled: d.hasFrames
                    onClicked: root.swapRequested()
                }
            }

            // Transform data (always shown, values are "-" when not valid)
            ColumnLayout {
                Layout.fillWidth: true
                Layout.leftMargin: 8
                Layout.rightMargin: 8
                spacing: 8

                GridLayout {
                    Layout.fillWidth: true
                    Layout.maximumWidth: 360
                    columns: 9
                    columnSpacing: 12
                    rowSpacing: 4

                    // Translation row: icon + x/y/z pairs
                    LetterIndicator {
                        color: palette.text
                        textColor: palette.mid
                        text: "\uf0b2"
                        font.family: IconFont.name
                        font.pixelSize: 10
                        Layout.alignment: Qt.AlignVCenter
                        tooltipText: "Translation"
                    }
                    Label { text: "x:"; font.family: "monospace" }
                    Label { text: d.formatNumber(d.tfTransform.translation.x); font.family: "monospace"; Layout.fillWidth: true; horizontalAlignment: Text.AlignRight }
                    Label { text: "y:"; font.family: "monospace" }
                    Label { text: d.formatNumber(d.tfTransform.translation.y); font.family: "monospace"; Layout.fillWidth: true; horizontalAlignment: Text.AlignRight }
                    Label { text: "z:"; font.family: "monospace" }
                    Label { text: d.formatNumber(d.tfTransform.translation.z); font.family: "monospace"; Layout.fillWidth: true; horizontalAlignment: Text.AlignRight }
                    Item { Layout.columnSpan: 2 }

                    // Rotation row: icon + x/y/z/w pairs
                    LetterIndicator {
                        color: palette.text
                        textColor: palette.mid
                        text: "\uf2f1"
                        font.family: IconFont.name
                        font.pixelSize: 10
                        Layout.alignment: Qt.AlignVCenter
                        tooltipText: "Rotation (Quaternion)"
                    }
                    Label { text: "x:"; font.family: "monospace" }
                    Label { text: d.formatNumber(d.tfTransform.rotation.x); font.family: "monospace"; Layout.fillWidth: true; horizontalAlignment: Text.AlignRight }
                    Label { text: "y:"; font.family: "monospace" }
                    Label { text: d.formatNumber(d.tfTransform.rotation.y); font.family: "monospace"; Layout.fillWidth: true; horizontalAlignment: Text.AlignRight }
                    Label { text: "z:"; font.family: "monospace" }
                    Label { text: d.formatNumber(d.tfTransform.rotation.z); font.family: "monospace"; Layout.fillWidth: true; horizontalAlignment: Text.AlignRight }
                    Label { text: "w:"; font.family: "monospace" }
                    Label { text: d.formatNumber(d.tfTransform.rotation.w); font.family: "monospace"; Layout.fillWidth: true; horizontalAlignment: Text.AlignRight }
                }

                RowLayout {
                    Layout.fillWidth: true
                    spacing: 8

                    IconTextButton {
                        objectName: "tfTransformPopupCopyJson"
                        iconText: IconFont.iconCopy
                        text: "JSON"
                        tooltipText: "Copy as JSON"
                        enabled: d.hasFrames && d.tfTransform.valid
                        onClicked: RQml.copyTextToClipboard(JSON.stringify(d.buildPayload(), null, 2))
                    }

                    IconTextButton {
                        objectName: "tfTransformPopupCopyYaml"
                        iconText: IconFont.iconCopy
                        text: "YAML"
                        tooltipText: "Copy as YAML"
                        enabled: d.hasFrames && d.tfTransform.valid
                        onClicked: RQml.copyTextToClipboard(d.payloadToYaml(d.buildPayload()))
                    }

                    Item { Layout.fillWidth: true }
                }
            }

            Item { Layout.preferredHeight: 4 }
        }
    }
}
